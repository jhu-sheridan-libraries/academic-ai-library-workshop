# ─── Persistence (FACILITATOR ONLY) ──────────────────────────────────────────
# Participants need none of this. With no table and no AWS credential set, the
# app stores progress in the server process: no account, no credential, no error.
# That is the intended participant experience.
#
# For the facilitator, persistence switches on automatically once a table name
# and any AWS credential source are both present. Force it either way with
# WORKSHOP_PERSISTENCE=dynamodb or WORKSHOP_PERSISTENCE=local.
#
# NOTE: `node build/index.js` does not read this file. Use `npm run start`,
# which passes --env-file=.env, or export the variables yourself.

AWS_REGION=us-east-1
AWS_PROFILE=drcc-ai
DYNAMODB_TABLE=LibraryWorkshop

# Optional: assume a role instead of using the profile directly. The credentials
# used to CALL AssumeRole come from the ambient chain (instance profile, SSO,
# named profile). No static access keys are used or expected either way.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/LibraryWorkshopRole
# AWS_ROLE_SESSION_NAME=library-workshop-session

# ─── App ─────────────────────────────────────────────────────────────────────
FACILITATOR_TOKEN=changeme
PUBLIC_COHORT=fall2026
